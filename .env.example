# Copy to .env and adjust. Used by docker-compose.

# Host folder that holds the local SSD mirror of the network share
# (the DST you pass to scripts/sync_images.py).
# Windows example: LOCAL_IMAGE_STORE=D:\imagestore
LOCAL_IMAGE_STORE=

# Network share root for displaying original paths in results,
# e.g. \\nas\share\renderings. Leave empty to show relative paths only.
NETWORK_ROOT=

# Embedding device: auto (cuda > mps > cpu), cuda, mps, or cpu.
# NOTE on macOS also run scripts/fix_mac_omp.sh once per venv — faiss-cpu and
# torch ship conflicting libomp copies that crash the server regardless of
# device. Linux/Docker unaffected.
DEVICE=auto

# Scan throughput tuning. BATCH_SIZE = images per embedding batch. Keep it
# modest for print-resolution renders (one decoded frame can be hundreds of
# MB); GPU hosts with ample RAM can raise it for throughput.
# DECODE_WORKERS/DECODE_PREFETCH control the scan-time decode pipeline: worker
# threads and max decoded images in memory.
BATCH_SIZE=64
DECODE_WORKERS=4
DECODE_PREFETCH=16

# Web UI / API port on the host.
METATRACE_PORT=8000

# Kick off an initial scan automatically when the index is empty at startup.
RUN_INITIAL_SCAN_ON_START=true

# Admin token for mutating endpoints (POST /api/rescan). When set, requests
# must send header `X-Admin-Token: <token>`. Leave EMPTY for trusted-LAN mode
# (mutations allowed; a warning is logged at startup).
METATRACE_ADMIN_TOKEN=

# Comma-separated list of extra allowed CORS origins, e.g.
# http://localhost:5173. The bundled SPA is same-origin, so CORS is DISABLED
# unless you serve the UI from a different origin.
METATRACE_CORS_ORIGINS=
