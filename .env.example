# Copy to .env and adjust. Used by docker-compose.

# Host folder that holds the local SSD mirror of the network share
# (the DST you pass to scripts/sync_images.py). Docker mounts this to /store;
# local non-Docker backend runs also accept it directly as the image store.
# Windows example: LOCAL_IMAGE_STORE=D:\imagestore
LOCAL_IMAGE_STORE=

# GHCR username for pulling the pre-built image (default: rpo081).
# Only needed on deploy servers; local dev uses docker-compose.override.yml.
GHCR_USER=rpo081

# Network share root for displaying original paths in results,
# e.g. \\nas\share\renderings. Leave empty to show relative paths only.
NETWORK_ROOT=

# Embedding device: auto (cuda > mps > cpu), cuda, mps, or cpu.
# NOTE on macOS also run scripts/fix_mac_omp.sh once per venv — faiss-cpu and
# torch ship conflicting libomp copies that crash the server regardless of
# device. Linux/Docker unaffected.
DEVICE=auto

# Scan throughput tuning. BATCH_SIZE = images per embedding batch. Keep it
# modest for print-resolution renders (one decoded frame can be hundreds of
# MB); GPU hosts with ample RAM can raise it for throughput.
# DECODE_WORKERS/DECODE_PREFETCH control the scan-time decode pipeline: worker
# threads and max decoded images in memory (frames are downscaled to 512 px in
# the worker, so these bound thread/window overhead, not full-res RAM).
BATCH_SIZE=64
DECODE_WORKERS=4
DECODE_PREFETCH=16

# Hard pixel cap for PSD composite rendering (decompression-bomb / OOM guard,
# default 100 Mpixel). Lower it on RAM-constrained hosts.
METATRACE_MAX_PIXELS=100000000

# Changing any of the above only needs `docker compose up -d` (container
# recreation) — NOT a rebuild.

# Web UI / API port on the host.
METATRACE_PORT=8000

# Kick off an initial scan automatically when the index is empty at startup.
RUN_INITIAL_SCAN_ON_START=true

# Admin token for mutating endpoints (POST /api/rescan). When set, requests
# must send header `X-Admin-Token: <token>`. Leave EMPTY for trusted-LAN mode
# (mutations allowed; a warning is logged at startup).
METATRACE_ADMIN_TOKEN=

# Comma-separated list of extra allowed CORS origins, e.g.
# http://localhost:5173. The bundled SPA is same-origin, so CORS is DISABLED
# unless you serve the UI from a different origin.
METATRACE_CORS_ORIGINS=

# --- Authentication (multi-user) --------------------------------------------
# Required for any internet-facing deployment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Min length 32. When unset, the server runs in trusted-LAN mode
# (X-Admin-Token + open registration) — DO NOT expose that to the internet.
METATRACE_JWT_SECRET=

# Set to false for local HTTP dev; cookies will then be sent over plain HTTP.
METATRACE_COOKIE_SECURE=true

# SameSite attribute for auth cookies. "lax" is recommended.
METATRACE_COOKIE_SAMESITE=lax

# Token lifetimes. Defaults shown.
METATRACE_ACCESS_TOKEN_TTL_MINUTES=15
METATRACE_REFRESH_TOKEN_TTL_DAYS=7

# Account lockout after this many failed logins (0 disables lockout).
METATRACE_LOCKOUT_THRESHOLD=5
METATRACE_LOCKOUT_MINUTES=15

# Trusted-LAN escape hatch. Leave false. Setting to true disables auth entirely
# when no JWT secret is set — only intended for isolated LAN deployments.
METATRACE_ALLOW_UNAUTH=false
